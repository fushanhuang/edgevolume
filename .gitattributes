# 强制 LF 行尾：Windows 的 git 默认会把 LF 转成 CRLF，
# 会导致 build-ipa.sh 在 macOS 上报语法错误、.tbd 无法被 ld 解析。
* text=auto eol=lf

*.sh          text eol=lf
*.tbd         text eol=lf
*.plist       text eol=lf
*.pbxproj     text eol=lf
*.h           text eol=lf
*.m           text eol=lf
*.py          text eol=lf
*.yml         text eol=lf
*.json        text eol=lf
*.xcscheme    text eol=lf

# 二进制资源
*.png         binary
*.jpg         binary
*.xcassets    -text
